    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0f675958-d8b3-440e-a3d6-fe41e458a981</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
